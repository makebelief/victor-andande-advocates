{
  "trailingSlash": false,
  "rewrites": [
    {"source": "/about", "destination": "/about.html"},
    {"source": "/services", "destination": "/services.html"},
    {"source": "/team", "destination": "/team.html"},
    {"source": "/why-us", "destination": "/why-us.html"},
    {"source": "/insights", "destination": "/insights.html"},
    {"source": "/contact", "destination": "/contact.html"},
    {"source": "/privacy", "destination": "/privacy.html"},
    {"source": "/terms", "destination": "/terms.html"},
    {"source": "/insights/deed-poll-overview", "destination": "/insights/deed-poll-overview.html"},
    {"source": "/insights/employment-termination-basics", "destination": "/insights/employment-termination-basics.html"},
    {"source": "/insights/land-transaction-checklist", "destination": "/insights/land-transaction-checklist.html"},
    {"source": "/insights/served-with-court-papers", "destination": "/insights/served-with-court-papers.html"},
    {"source": "/insights/succession-first-steps", "destination": "/insights/succession-first-steps.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/(assets|images)/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    }
  ]
}
